@page "/charts"

@* <h1 style="color:lightgreen;">📊 Energy Output</h1> *@
<h1 style="color:#58a6ff;">📊 Energy Output Trend</h1>

<div style="
    display:flex;
    align-items:flex-end;
    height:300px;
    background:#161b22;
    padding:20px;
    border-radius:12px;
    gap:10px;">

    @foreach (var item in data.Select((v, i) => new { Value = v, Index = i }))
    {
        <div style="flex:1; text-align:center;">
            <!-- 🔥 INSIGHTS PANEL -->
            <div style="
                margin-top:20px;
                background:#1e1e1e;
                padding:15px;
                border-radius:10px;
                color:white;">

                <h3 style="color:#58a6ff;">📈 Insights</h3>

                <p>
                    🔥 Peak Output:
                    <strong>@maxValue kW</strong>
                    at <strong>@maxTime</strong>
                </p>

                <p>
                    ⚠️ Lowest Output:
                    <strong>@minValue kW</strong>
                    at <strong>@minTime</strong>
                </p>

            </div>
            <!-- BAR -->
            <div style="
                    background:linear-gradient(to top,#238636,#2ea043);
                    height:@(item.Value / 2)px;
                    border-radius:6px;
                    display:flex;
                    align-items:flex-end;
                    justify-content:center;
                    color:white;
                    font-size:14px;">
                @item.Value
            </div>

            <!-- LABEL -->
            <p style="color:white;margin-top:5px;">
                @(10 + item.Index) AM
            </p>

        </div>
    }

</div>

@code {
    List<int> data = new() { 400, 450, 300, 500, 100 };

    int maxValue;
    int minValue;
    string maxTime = "";
    string minTime = "";

    protected override void OnInitialized()
    {
        maxValue = data.Max();
        minValue = data.Min();

        int maxIndex = data.IndexOf(maxValue);
        int minIndex = data.IndexOf(minValue);

        maxTime = $"{10 + maxIndex} AM";
        minTime = $"{10 + minIndex} AM";
    }
}