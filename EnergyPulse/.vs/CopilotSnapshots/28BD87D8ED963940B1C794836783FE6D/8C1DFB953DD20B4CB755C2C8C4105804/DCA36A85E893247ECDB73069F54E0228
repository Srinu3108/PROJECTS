@page "/alerts"
@inject HttpClient Http

<div style="
    display:flex;
    justify-content:center;
    align-items:flex-start;
    width:100%;
    min-height:80vh;
">

    <div style="width:100%;max-width:1100px;">

        <h1 style="color:red;font-size:32px;margin-bottom:20px;">
            🚨 Alerts
        </h1>

        @if (alerts == null)
        {
            <p>Loading alerts...</p>
        }
        else
        {
            <div style="margin-bottom:15px;">

                <button @onclick='() => selectedSeverity = ""'
                        style="margin-right:10px;">
                    All
                </button>

                <button @onclick='() => selectedSeverity = "High"'
                        style="margin-right:10px;color:red;">
                    High
                </button>

                <button @onclick='() => selectedSeverity = "Medium"'
                        style="color:orange;">
                    Medium
                </button>

            </div>
            <table style="
                width:100%;
                background:#161b22;
                border-radius:12px;
                color:white;
                font-size:18px;
                overflow:hidden;
            ">
                <thead>
                    <tr style="background:#0d1117;">
                        <th>Device</th>
                        <th>Message</th>
                        <th>Severity</th>
                        <th>Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alert in alerts.Where(a =>
                                    string.IsNullOrEmpty(selectedSeverity) || a.Severity == selectedSeverity))
                    {
                        <tr style="height:55px;border-bottom:1px solid #30363d;
                           background:@(alert.Severity == "High" ? "#2d0f0f" : "transparent");">

                            <td>
                                <strong>Device @alert.DeviceId</strong>
                            </td>

                            <td style="font-size:16px;">
                                @alert.Message
                            </td>

                                <td>
                                    <span style="
                                    padding:5px 10px;
                                    border-radius:8px;
                                    background:@GetBgColor(alert.Severity);
                                    color:white;
                                    font-weight:bold;">

                                        @(alert.Severity == "High" ? "🔴 HIGH"
                                                            : alert.Severity == "Medium" ? "🟡 MEDIUM"
                                                                    : "⚪ LOW")
                                    </span>
                                </td>

                            <td style="color:gray;">
                                @alert.CreatedAt.ToString("g")
                            </td>

                        </tr>
                        }
                </tbody>
            </table>

        }

        @code {
            List<AlertDto>? alerts;
            string selectedSeverity = "";

            protected override async Task OnInitializedAsync()
            {
                alerts = await Http.GetFromJsonAsync<List<AlertDto>>("api/alert");
            }
            string GetColor(string severity)
            {
                return severity switch
                {
                    "High" => "red",
                    "Medium" => "orange",
                    _ => "white"
                };
            }
            string GetBgColor(string severity)
            {
                return severity switch
                {
                    "High" => "#da3633",
                    "Medium" => "#f1c40f",
                    _ => "#6e7681"
                };
            }

            public class AlertDto
            {
                public int DeviceId { get; set; }
                public string Message { get; set; } = "";
                public string Severity { get; set; } = "";
                public DateTime CreatedAt { get; set; }
            }
        }
    </div>
</div>