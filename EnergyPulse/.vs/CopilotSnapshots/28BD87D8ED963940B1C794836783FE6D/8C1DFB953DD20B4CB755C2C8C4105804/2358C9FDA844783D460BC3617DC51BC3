@page "/devices"
@inject HttpClient Http

<div style="
    display:flex;
    justify-content:center;
    width:100%;
">
    <div style="width:100%;max-width:1100px;">

        <h1 style="color:lightblue;">⚙️ Device Management</h1>
        <button @onclick='() => FilterStatus = ""'
                style="margin-right:10px;background:#30363d;color:white;padding:6px 12px;border:none;border-radius:6px;">
            All
        </button>

        <button @onclick='() => FilterStatus = "Active"'
                style="margin-right:10px;background:#238636;color:white;padding:6px 12px;border:none;border-radius:6px;">
            🟢 Active
        </button>

        <button @onclick='() => FilterStatus = "Offline"'
                style="background:#da3633;color:white;padding:6px 12px;border:none;border-radius:6px;">
            🔴 Offline
        </button>
        <button @onclick="ToggleRole"
                style="margin-bottom:15px;background:#30363d;color:white;padding:6px 12px;border:none;border-radius:6px;">
            Switch Role (Current: @(isAdmin ? "Admin" : "Viewer"))
        </button>

        <!-- 🔹 ADD DEVICE FORM -->
        @if (isAdmin)
        {
            <div style="background:#161b22;padding:20px;border-radius:12px;margin-bottom:20px;">
                <h3>Add New Device</h3>

                <input placeholder="Device Name" @bind="newDevice.name" />
                <input placeholder="Status" @bind="newDevice.status" />
                <input type="number" placeholder="Site ID" @bind="newDevice.siteId" />

                <button @onclick="AddDevice"
                        style="background:#238636;color:white;padding:6px 12px;border:none;border-radius:6px;">
                    ➕ Add
                </button>
        
            </div>
        }

        <!-- 🔹 DEVICE TABLE -->
        @if (devices == null)
        {
            <p style="color:gray;font-size:18px;">⏳ Loading data...</p>
        }
        @if (devices != null && !devices.Any())
        {
            <p style="color:gray;">No devices found.</p>
        }
        else
        {
            <input placeholder="🔍 Search device..."
                   @bind="searchText"
                   style="padding:8px;width:250px;margin-bottom:15px;border-radius:6px;border:none;" />
            <div style="max-height:500px;overflow-y:auto;">

            <table style="width:100%;color:white;background:#161b22;font-size:18px;">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in devices.Where(d =>
    (string.IsNullOrEmpty(FilterStatus) || d.status == FilterStatus) &&
    (string.IsNullOrEmpty(searchText) || d.name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
))
                    {
                        <tr>
                            <td>@d.id</td>

                            <td>
                                @if (editId == d.id)
                                {
                                    <input @bind="editDevice.name" />
                                }
                                else
                                {
                                    @d.name
                                }
                            </td>

                            <td>
                                @if (editId == d.id)
                                {
                                    <input @bind="editDevice.status" />
                                }
                                else
                                {
                                    <span style="
                                color:@(d.status == "Active" ? "#2ecc71" : "#e74c3c");
                                font-weight:bold;">

                                        @(d.status == "Active" ? "🟢 Active" : "🔴 Offline")

                                    </span>
                                }
                            </td>

                            <td>
                                @if (editId == d.id)
                                {
                                    @if (isAdmin)
                                    {
                                        <button @onclick="UpdateDevice"
                                                style="background:#238636;color:white;padding:6px 12px;border:none;border-radius:6px;">
                                            💾 Save
                                        </button>

                                        <button @onclick="CancelEdit"
                                                style="background:#6e7681;color:white;padding:6px 12px;border:none;border-radius:6px;">
                                            ❌ Cancel
                                        </button>
                                    }
                                }
                                else
                                {
                                    @if (isAdmin)
                                    {
                                        <button @onclick="() => StartEdit(d)"
                                                style="background:#1f6feb;color:white;padding:6px 12px;border:none;border-radius:6px;">
                                            ✏️ Edit
                                        </button>

                                        <button @onclick="() => DeleteDevice(d.id)"
                                                style="background:#da3633;color:white;padding:6px 12px;border:none;border-radius:6px;">
                                            ❌ Delete
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="color:gray;">View Only</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }

        @code {
            bool isAdmin = false; // change to false to test
            List<DeviceDto> devices;
            string searchText = "";

            DeviceDto newDevice = new DeviceDto();

            protected override async Task OnInitializedAsync()
            {
                await LoadDevices();
            }

            async Task LoadDevices()
            {
                devices = await Http.GetFromJsonAsync<List<DeviceDto>>("api/device");
            }

            async Task AddDevice()
            {
                await Http.PostAsJsonAsync("api/device", newDevice);
                newDevice = new DeviceDto();
                await LoadDevices();
            }

            async Task DeleteDevice(int id)
            {
                await Http.DeleteAsync($"api/device/{id}");
                await LoadDevices();
            }

            int editId = 0;
            DeviceDto editDevice = new DeviceDto();

            void StartEdit(DeviceDto d)
            {
                editId = d.id;
                editDevice = new DeviceDto
                {
                    id = d.id,
                    name = d.name,
                    status = d.status,
                    siteId = d.siteId
                };
            }

            async Task UpdateDevice()
            {
                await Http.PutAsJsonAsync($"api/device/{editDevice.id}", editDevice);
                editId = 0;
                await LoadDevices();
            }

            void CancelEdit()
            {
                editId = 0;
            }

            public class DeviceDto
            {
                public int id { get; set; }
                public string name { get; set; }
                public string status { get; set; }
                public int siteId { get; set; }
            }
            void ToggleRole()
            {
                isAdmin = !isAdmin;
            }
            string FilterStatus = "";

    
        }
    </div>
</div>