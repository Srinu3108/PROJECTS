@page "/alerts"
@inject HttpClient Http

<div style="
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 20px;
    background: linear-gradient(135deg, #0d1117 0%, #161b22 100%);
    min-height: 100vh;
    ">

    <div style="width: 100%; max-width: 1100px;">

        <!-- Header -->
        <div style="text-align: center; margin-bottom: 30px;">
            <h1 style="color: #da3633; font-size: 32px; margin: 0; margin-bottom: 8px;">
                🚨 Alerts
            </h1>
            <p style="color: #8b949e; font-size: 14px; margin: 0;">
                Monitor and track system alerts in real-time
            </p>
        </div>

        @if (alerts == null && string.IsNullOrEmpty(errorMessage))
        {
            <div style="
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 60px 20px;
                background: #161b22;
                border-radius: 12px;
                border: 1px solid #30363d;
                ">
                <p style="color: #8b949e; font-size: 18px; margin: 0;">
                    ⏳ Loading alerts...
                </p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 60px 20px;
                background: #2d0f0f;
                border-radius: 12px;
                border: 1px solid #da3633;
                ">
                <div>
                    <p style="color: #da3633; font-size: 18px; margin: 0 0 10px 0;">
                        ❌ Error Loading Alerts
                    </p>
                    <p style="color: #e6edf3; font-size: 14px; margin: 0;">
                        @errorMessage
                    </p>
                    <button @onclick="ReloadAlerts" style="
                        margin-top: 15px;
                        padding: 8px 16px;
                        background: #238636;
                        color: white;
                        border: none;
                        border-radius: 6px;
                        cursor: pointer;
                        ">
                        🔄 Retry
                    </button>
                </div>
            </div>
        }
        else if (alerts != null && alerts.Count == 0)
        {
            <div style="
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 60px 20px;
                background: #161b22;
                border-radius: 12px;
                border: 1px solid #30363d;
                ">
                <div style="text-align: center;">
                    <p style="color: #2ecc71; font-size: 24px; margin: 0 0 10px 0;">
                        ✅ No Alerts
                    </p>
                    <p style="color: #8b949e; font-size: 14px; margin: 0;">
                        System is running smoothly with no active alerts
                    </p>
                </div>
            </div>
        }
        else
        {
            <!-- Filter Buttons -->
            <div style="
                display: flex;
                gap: 10px;
                margin-bottom: 20px;
                flex-wrap: wrap;
                ">
                <button @onclick='() => { selectedSeverity = ""; StateHasChanged(); }' style="
                    padding: 8px 16px;
                    background: @(string.IsNullOrEmpty(selectedSeverity) ? "#238636" : "#30363d");
                    color: white;
                    border: none;
                    border-radius: 6px;
                    cursor: pointer;
                    font-size: 14px;
                    font-weight: 600;
                    ">
                    All (@alerts.Count)
                </button>

                <button @onclick='() => { selectedSeverity = "Critical"; StateHasChanged(); }' style="
                    padding: 8px 16px;
                    background: @(selectedSeverity == "Critical" ? "#da3633" : "#30363d");
                    color: white;
                    border: none;
                    border-radius: 6px;
                    cursor: pointer;
                    font-size: 14px;
                    font-weight: 600;
                    ">
                    🔴 Critical (@CountBySeverity("Critical"))
                </button>

                <button @onclick='() => { selectedSeverity = "High"; StateHasChanged(); }' style="
                    padding: 8px 16px;
                    background: @(selectedSeverity == "High" ? "#da3633" : "#30363d");
                    color: white;
                    border: none;
                    border-radius: 6px;
                    cursor: pointer;
                    font-size: 14px;
                    font-weight: 600;
                    ">
                    🔴 High (@CountBySeverity("High"))
                </button>

                <button @onclick='() => { selectedSeverity = "Medium"; StateHasChanged(); }' style="
                    padding: 8px 16px;
                    background: @(selectedSeverity == "Medium" ? "#f1c40f" : "#30363d");
                    color: @(selectedSeverity == "Medium" ? "#0d1117" : "white");
                    border: none;
                    border-radius: 6px;
                    cursor: pointer;
                    font-size: 14px;
                    font-weight: 600;
                    ">
                    🟡 Medium (@CountBySeverity("Medium"))
                </button>

                <button @onclick='() => { selectedSeverity = "Low"; StateHasChanged(); }' style="
                    padding: 8px 16px;
                    background: @(selectedSeverity == "Low" ? "#238636" : "#30363d");
                    color: white;
                    border: none;
                    border-radius: 6px;
                    cursor: pointer;
                    font-size: 14px;
                    font-weight: 600;
                    ">
                    ⚪ Low (@CountBySeverity("Low"))
                </button>
            </div>

            
            <!-- Alerts Table -->
            <div style="
                background: #161b22;
                border-radius: 12px;
                border: 1px solid #30363d;
                overflow: hidden;
                ">
                <table style="
                    width: 100%;
                    border-collapse: collapse;
                    color: white;
                    ">
                    <thead>
                        <tr style="
                            background: #0d1117;
                            border-bottom: 2px solid #30363d;
                            ">
                            <th style="
                            padding: 15px;
                            text-align: left;
                            font-size: 14px;
                            font-weight: 600;
                            color: #8b949e;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                            ">Device</th>
                            <th style="
                            padding: 15px;
                            text-align: left;
                            font-size: 14px;
                            font-weight: 600;
                            color: #8b949e;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                            ">Message</th>
                            <th style="
                            padding: 15px;
                            text-align: center;
                            font-size: 14px;
                            font-weight: 600;
                            color: #8b949e;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                            ">Severity</th>
                            <th style="
                            padding: 15px;
                            text-align: left;
                            font-size: 14px;
                            font-weight: 600;
                            color: #8b949e;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                            ">Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- New filter with case-insensitive comparison -->
                        @foreach (var alert in alerts.Where(a =>
                            string.IsNullOrEmpty(selectedSeverity) ||
                            string.Equals(a.Severity, selectedSeverity, StringComparison.OrdinalIgnoreCase)))
                        {
                            <tr style="
                                border-bottom: 1px solid #30363d;
                                background: @(alert.Severity == "High" ? "rgba(218, 54, 51, 0.1)" : "transparent");
                                transition: background-color 0.2s ease;
                                padding: 0;
                                ">
                                <td style="
                                    padding: 15px;
                                    font-weight: 600;
                                    color: #58a6ff;
                                    ">
                                    Device #@alert.DeviceId
                                </td>

                                <td style="
                                    padding: 15px;
                                    font-size: 15px;
                                    color: #e6edf3;
                                    ">
                                    @alert.Message
                                </td>

                                <td style="
                                    padding: 15px;
                                    text-align: center;
                                    ">
                                    <span style="
                                        display: inline-block;
                                        padding: 6px 12px;
                                        border-radius: 6px;
                                        background: @GetBgColor(alert.Severity);
                                        color: @GetTextColor(alert.Severity);
                                        font-weight: 600;
                                        font-size: 13px;
                                        ">
                                        @(alert.Severity == "Critical" ? "🔴 CRITICAL"
                                        : alert.Severity == "High" ? "🔴 HIGH"
                                            : alert.Severity == "Medium" ? "🟡 MEDIUM"
                                                : "⚪ LOW")
                                    </span>
                                </td>

                                <td style="
                                    padding: 15px;
                                    color: #8b949e;
                                    font-size: 14px;
                                    ">
                                    @alert.CreatedAt.ToString("g")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>

@code {
    List<AlertDto>? alerts;
    string selectedSeverity = "";
    string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAlerts();
    }

    async Task LoadAlerts()
    {
        try
        {
            errorMessage = "";
            Console.WriteLine("📡 Fetching alerts...");
            var response = await Http.GetAsync("api/alerts");
            var content = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Alerts response: {content}");

            if (response.IsSuccessStatusCode)
            {
                var options = new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                };

                // ✅ Handle both array and paginated response
                if (content.TrimStart().StartsWith("{"))
                {
                    var result = System.Text.Json.JsonSerializer.Deserialize<AlertApiResponse>(content, options);
                    alerts = result?.Alerts ?? new List<AlertDto>();
                }
                else
                {
                    alerts = System.Text.Json.JsonSerializer.Deserialize<List<AlertDto>>(content, options) ?? new List<AlertDto>();
                }

                // ✅ FIX: Normalize severity values (trim and proper case)
                Console.WriteLine("=== ALERT SEVERITIES FROM API ===");
                foreach (var alert in alerts)
                {
                    if (!string.IsNullOrEmpty(alert.Severity))
                    {
                        var original = alert.Severity.Trim();
                        // Convert to Title Case (first letter uppercase, rest lowercase)
                        alert.Severity = char.ToUpper(original[0]) + original.Substring(1).ToLower();
                        Console.WriteLine($"Message: '{alert.Message}', Severity: '{original}' -> '{alert.Severity}'");
                    }
                    else
                    {
                        Console.WriteLine($"Message: '{alert.Message}', Severity: (null or empty)");
                    }
                }
                Console.WriteLine("==================================");

                Console.WriteLine($"✅ Loaded {alerts.Count} alerts");
            }
            else
            {
                errorMessage = $"Error: {response.StatusCode}";
                Console.WriteLine($"❌ Error: {response.StatusCode}");
                alerts = new List<AlertDto>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load alerts: {ex.Message}";
            Console.WriteLine($"❌ Exception: {ex.Message}");
            alerts = new List<AlertDto>();
        }
    }
    async Task ReloadAlerts()
    {
        await LoadAlerts();
        StateHasChanged();
    }
    // Helper method for case-insensitive severity count
    int CountBySeverity(string severity)
    {
        return alerts?.Count(a => string.Equals(a.Severity, severity, StringComparison.OrdinalIgnoreCase)) ?? 0;
    }

    string GetBgColor(string severity)
    {
        return severity switch
        {
            "Critical" => "#da3633",
            "High" => "#da3633",
            "Medium" => "#f1c40f",
            _ => "#6e7681"
        };
    }

    string GetTextColor(string severity)
    {
        return severity switch
        {
            "Medium" => "#0d1117",
            _ => "white"
        };
    }

    public class AlertDto
    {
        public int Id { get; set; }
        public int DeviceId { get; set; }
        public string DeviceName { get; set; } = "";
        public string AlertType { get; set; } = "";
        public string Message { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public DateTime? ResolvedAt { get; set; }
        public string Severity { get; set; } = "";
        public string Status { get; set; } = "";
        public double? ImpactKW { get; set; }
        public double? EstimatedCost { get; set; }
    }

    public class AlertApiResponse
    {
        public int TotalCount { get; set; }
        public int PageNumber { get; set; }
        public int PageSize { get; set; }
        public List<AlertDto> Alerts { get; set; } = new();
    }
}