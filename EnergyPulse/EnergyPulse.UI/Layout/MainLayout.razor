@using Microsoft.AspNetCore.Components.Authorization
@using EnergyPulse.UI.Services
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject EnergyPulse.UI.Services.AuthService AuthService
@inject IJSRuntime JS

@code {
    private bool sidebarCollapsed = false;
    private bool isAuthenticated = false;
    private string username = "";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        username = user.Identity?.Name ?? "";
        var redirect = await JS.InvokeAsync<string>("sessionStorage.getItem", "redirect");
        if (!string.IsNullOrEmpty(redirect) && redirect != "/")
        {
            await JS.InvokeVoidAsync("sessionStorage.removeItem", "redirect");
            Navigation.NavigateTo("/PROJECTS" + redirect);
        }
    }

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    private async Task Logout()
    {
        await AuthService.Logout();
        await UpdateAuthState(); // 🔥 Refresh after logout
        Navigation.NavigateTo("/PROJECTS" + redirect);
    }
    // 🔥 ADD THIS METHOD - Refreshes auth state
    private async Task UpdateAuthState()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        username = user.Identity?.Name ?? "";
        StateHasChanged(); // Force UI to update
    }
}

<div style="display:flex;height:100vh;overflow:hidden;">

    <!-- Sidebar - Slides in/out -->
    <div style="
        width: 250px;
        background: #0d1117;
        color: white;
        flex-shrink: 0;
        transition: all 0.3s ease-in-out;
        margin-left: @(sidebarCollapsed ? "-250px" : "0");
        overflow: hidden;
        border-right: 1px solid #30363d;
        ">
        <NavMenu IsCollapsed="@sidebarCollapsed" OnToggleSidebar="ToggleSidebar" />
    </div>

    <!-- Main Content - Expands when sidebar collapses -->
    <div style="
        flex: 1;
        background: linear-gradient(135deg, #0d1117 0%, #161b22 100%);
        color: white;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        transition: all 0.3s ease-in-out;
        ">

        <!-- Top Bar with Hamburger -->
        <div style="
            position: sticky;
            top: 0;
            z-index: 100;
            background: #0d1117;
            border-bottom: 1px solid #30363d;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            flex-shrink: 0;
            ">
            <button @onclick="ToggleSidebar" style="
                background: transparent;
                border: none;
                color: #58a6ff;
                font-size: 26px;
                cursor: pointer;
                padding: 4px 8px;
                border-radius: 6px;
                transition: all 0.2s ease;
                " onmouseover="this.style.background='rgba(88,166,255,0.1)'"
                    onmouseout="this.style.background='transparent'">
                ☰
            </button>
            <div style="display:flex;align-items:center;gap:12px;">
                <span style="font-size:20px;">⚡</span>
                <span style="color:#2ecc71;font-weight:700;font-size:18px;">EnergyPulse</span>
                <span style="color:#8b949e;font-size:12px;">| Dashboard</span>
            </div>
            <div style="flex:1;"></div>
            <!-- 🔥 MOVED HERE - Login/Logout buttons on the RIGHT -->
            <div style="display:flex;align-items:center;gap:12px;">
                @if (isAuthenticated)
                {
                    <span style="color:#8b949e;font-size:13px;">👋 @username</span>
                    <button @onclick="Logout" style="
                    background: #da3633;
                    color: white;
                    border: none;
                    border-radius: 6px;
                    padding: 6px 14px;
                    font-size: 12px;
                    cursor: pointer;
                    font-weight: 600;
                    ">Logout</button>
                }
                else
                {
                    <a href="login" style="
                    color: #58a6ff;
                    text-decoration: none;
                    font-size: 13px;
                    font-weight: 500;
                    ">Login</a>
                    <a href="register" style="
                    background: #238636;
                    color: white;
                    border: none;
                    border-radius: 6px;
                    padding: 6px 14px;
                    font-size: 12px;
                    text-decoration: none;
                    font-weight: 600;
                    ">Register</a>
                }
            </div>

            <div style="
                display:flex;
                align-items:center;
                gap:8px;
                color:#8b949e;
                font-size:12px;
                ">
                <span style="display:flex;align-items:center;gap:6px;">
                    <span
                    style="width:8px;height:8px;background:#2ecc71;border-radius:50%;display:inline-block;"></span>
                    System Operational
                </span>
            </div>
        </div>

        <!-- Page Content -->
        <div style="
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            ">
            @Body
        </div>
    </div>

</div>

<style>
    /* Smooth scroll for the content area */
    ::-webkit-scrollbar {
        width: 6px;
    }

    ::-webkit-scrollbar-track {
        background: #161b22;
    }

    ::-webkit-scrollbar-thumb {
        background: #30363d;
        border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #238636;
    }
</style>
