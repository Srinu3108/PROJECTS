@inherits LayoutComponentBase

<div style="display:flex;height:100vh;">

    <!-- Sidebar -->
    <div style="width:250px;background:#111;color:white;">
        <NavMenu />
    </div>

    <!-- Main Content -->
    <div style="
        flex:1;
        background:#1e1e1e;
        color:white;
        display:flex;
        justify-content:center;
