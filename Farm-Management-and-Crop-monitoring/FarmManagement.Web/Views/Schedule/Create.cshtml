@model FarmManagement.Web.Models.ViewModels.ScheduleViewModel

@{
    ViewData["Title"] = "New Planting Schedule";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#dbeafe;color:#2563eb;">
                <i class="bi bi-calendar-plus"></i>
            </span>
            New Planting Schedule
        </h1>
        <p>Plan a new crop planting and set the expected yield.</p>
    </div>
    <a asp-action="Index" class="btn-fm btn-outline-fm">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="fm-card">
            <div class="fm-card-header">
                <span class="ch-title"><i class="bi bi-calendar3" style="color:#2563eb;"></i> Schedule Details</span>
            </div>
            <div class="fm-card-body fm-form">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="fm-alert fm-alert-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CropId" class="form-label"></label>
                            <div class="fm-field">
                                <i class="bi bi-flower1 fm-fi" style="color:#16a34a;"></i>
                                <select asp-for="CropId" class="form-select" asp-items="Model.Crops">
                                    <option value="">-- Select Crop --</option>
                                </select>
                            </div>
                            <span asp-validation-for="CropId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FieldId" class="form-label"></label>
                            <div class="fm-field">
                                <i class="bi bi-map fm-fi" style="color:#0d9488;"></i>
                                <select asp-for="FieldId" class="form-select" asp-items="Model.Fields">
                                    <option value="">-- Select Field --</option>
                                </select>
                            </div>
                            <span asp-validation-for="FieldId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ScheduledDate" class="form-label"></label>
                            <div class="fm-field">
                                <i class="bi bi-calendar3 fm-fi" style="color:#2563eb;"></i>
                                <input asp-for="ScheduledDate" class="form-control" type="date" />
                            </div>
                            <span asp-validation-for="ScheduledDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpectedYieldKg" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ExpectedYieldKg" class="form-control" placeholder="e.g. 3500" />
                                <span class="input-group-text">kg</span>
                            </div>
                            <span asp-validation-for="ExpectedYieldKg" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <div class="fm-field fm-field-ta">
                                <i class="bi bi-chat-left-text fm-fi"></i>
                                <textarea asp-for="Notes" class="form-control" rows="3"
                                          placeholder="Optional notes about this schedule..."></textarea>
                            </div>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="fm-actions">
                        <button type="button" class="btn-fm btn-outline-fm" id="btnToggleResources">
                            <i class="bi bi-plus-circle"></i> Add Resource
                        </button>
                        <button type="submit" class="btn-fm btn-primary-fm">
                            <i class="bi bi-check-circle"></i> Save Schedule
                        </button>
                        <a asp-action="Index" class="btn-fm btn-ghost-fm">Cancel</a>
                    </div>
                    <div id="resHiddenFields"></div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6" id="resourceSection" style="display:none;">
        <div class="fm-card">
            <div class="fm-card-header">
                <span class="ch-title"><i class="bi bi-box-seam" style="color:#ea580c;"></i> Assign Resource to Schedule</span>
            </div>
            <div class="fm-card-body fm-form">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Resource Name</label>
                        <div class="fm-field">
                            <i class="bi bi-box-seam fm-fi" style="color:#ea580c;"></i>
                            <select id="resName" class="form-select">
                                <option value="">-- Select Resource --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Type</label>
                        <div class="fm-field">
                            <i class="bi bi-box fm-fi"></i>
                            <input type="text" id="resType" class="form-control" readonly placeholder="Auto-filled" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Available</label>
                        <div class="fm-field">
                            <i class="bi bi-archive fm-fi" style="color:#16a34a;"></i>
                            <input type="text" id="resAvailable" class="form-control" readonly placeholder="—" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Quantity Used</label>
                        <div class="fm-field">
                            <i class="bi bi-hash fm-fi"></i>
                            <input type="number" id="resQty" class="form-control" placeholder="e.g. 10" step="0.01" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Unit</label>
                        <div class="fm-field">
                            <i class="bi bi-123 fm-fi"></i>
                            <input type="text" id="resUnit" class="form-control" readonly placeholder="Auto-filled" />
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes (optional)</label>
                        <div class="fm-field">
                            <i class="bi bi-chat-left-text fm-fi"></i>
                            <input type="text" id="resNotes" class="form-control" placeholder="e.g. Applied for soil preparation" />
                        </div>
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="button" id="btnAddToSchedule" class="btn-fm btn-primary-fm">
                        <i class="bi bi-plus-circle"></i> Add to Schedule
                    </button>
                    <span id="resMessage" class="text-success small align-self-center" style="display:none;"></span>
                    <span id="resError" class="text-danger small align-self-center" style="display:none;"></span>
                </div>
            </div>
        </div>

        <div class="fm-card mt-3">
            <div class="fm-card-header">
                <span class="ch-title"><i class="bi bi-table" style="color:#ea580c;"></i> Resources Assigned</span>
                <span id="resCount" style="font-size:.78rem;color:var(--fm-muted);">0 records</span>
            </div>
            <div style="overflow-x:auto;">
                <table class="fm-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Resource</th>
                            <th>Type</th>
                            <th>Qty Used</th>
                            <th>Unit</th>
                            <th>Notes</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="resTableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (function () {
            var section = document.getElementById('resourceSection');
            var toggleBtn = document.getElementById('btnToggleResources');
            var tbody = document.getElementById('resTableBody');
            var countSpan = document.getElementById('resCount');
            var hiddenContainer = document.getElementById('resHiddenFields');
            var msg = document.getElementById('resMessage');
            var err = document.getElementById('resError');
            var resNameSelect = document.getElementById('resName');
            var resTypeInput = document.getElementById('resType');
            var resUnitInput = document.getElementById('resUnit');
            var resAvailable = document.getElementById('resAvailable');
            var resQtyInput = document.getElementById('resQty');
            var resNotesInput = document.getElementById('resNotes');

            var allResources = [];
            var assignedList = [];

            // Load existing resources for the dropdown
            function loadResources() {
                fetch('@Url.Action("GetResourcesJson")')
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        allResources = data;
                        resNameSelect.innerHTML = '<option value="">-- Select Resource --</option>';
                        for (var i = 0; i < data.length; i++) {
                            var opt = document.createElement('option');
                            opt.value = data[i].resourceId;
                            opt.textContent = data[i].name;
                            opt.setAttribute('data-type', data[i].type);
                            opt.setAttribute('data-unit', data[i].unit);
                            opt.setAttribute('data-qty', data[i].quantity);
                            opt.setAttribute('data-name', data[i].name);
                            resNameSelect.appendChild(opt);
                        }
                    });
            }

            // Auto-fill type, unit, available when resource selected
            resNameSelect.addEventListener('change', function () {
                var sel = this.options[this.selectedIndex];
                if (sel && sel.value) {
                    resTypeInput.value = sel.getAttribute('data-type') || '';
                    resUnitInput.value = sel.getAttribute('data-unit') || '';
                    resAvailable.value = sel.getAttribute('data-qty') || '';
                } else {
                    resTypeInput.value = '';
                    resUnitInput.value = '';
                    resAvailable.value = '';
                }
            });

            function renderAssigned() {
                var html = '';
                hiddenContainer.innerHTML = '';
                for (var i = 0; i < assignedList.length; i++) {
                    var a = assignedList[i];
                    html += '<tr>'
                        + '<td style="color:var(--fm-muted);font-size:.8rem;">' + (i + 1) + '</td>'
                        + '<td style="font-weight:600;">' + a.name + '</td>'
                        + '<td><span class="badge-pill badge-gray">' + a.type + '</span></td>'
                        + '<td style="font-weight:700;">' + a.qty + '</td>'
                        + '<td>' + a.unit + '</td>'
                        + '<td>' + (a.notes || '—') + '</td>'
                        + '<td><button type="button" class="btn-fm btn-danger-fm btn-sm-fm btn-remove-res" data-idx="' + i + '"><i class="bi bi-trash"></i></button></td>'
                        + '</tr>';

                    hiddenContainer.innerHTML +=
                        '<input type="hidden" name="ResourceUsages[' + i + '].ResourceId" value="' + a.resourceId + '" />'
                        + '<input type="hidden" name="ResourceUsages[' + i + '].QuantityUsed" value="' + a.qty + '" />'
                        + '<input type="hidden" name="ResourceUsages[' + i + '].Notes" value="' + (a.notes || '') + '" />';
                }
                tbody.innerHTML = html;
                countSpan.textContent = assignedList.length + ' records';

                // Bind remove buttons
                var removeBtns = tbody.querySelectorAll('.btn-remove-res');
                for (var j = 0; j < removeBtns.length; j++) {
                    removeBtns[j].addEventListener('click', function () {
                        assignedList.splice(parseInt(this.getAttribute('data-idx')), 1);
                        renderAssigned();
                    });
                }
            }

            toggleBtn.addEventListener('click', function () {
                if (section.style.display === 'none') {
                    section.style.display = 'block';
                    this.innerHTML = '<i class="bi bi-x-circle"></i> Hide Resources';
                    loadResources();
                } else {
                    section.style.display = 'none';
                    this.innerHTML = '<i class="bi bi-plus-circle"></i> Add Resource';
                }
            });

            document.getElementById('btnAddToSchedule').addEventListener('click', function () {
                msg.style.display = 'none';
                err.style.display = 'none';

                var sel = resNameSelect.options[resNameSelect.selectedIndex];
                var resourceId = parseInt(resNameSelect.value);
                var qty = parseFloat(resQtyInput.value);
                var notes = resNotesInput.value;

                if (!resourceId || isNaN(qty) || qty <= 0) {
                    err.textContent = 'Please select a resource and enter a valid quantity.';
                    err.style.display = 'inline';
                    return;
                }

                var available = parseFloat(sel.getAttribute('data-qty'));
                if (qty > available) {
                    err.textContent = 'Quantity used (' + qty + ') exceeds available stock (' + available + ').';
                    err.style.display = 'inline';
                    return;
                }

                assignedList.push({
                    resourceId: resourceId,
                    name: sel.getAttribute('data-name'),
                    type: sel.getAttribute('data-type'),
                    qty: qty,
                    unit: sel.getAttribute('data-unit'),
                    notes: notes
                });

                renderAssigned();
                msg.textContent = 'Resource added to schedule!';
                msg.style.display = 'inline';
                resNameSelect.value = '';
                resTypeInput.value = '';
                resUnitInput.value = '';
                resAvailable.value = '';
                resQtyInput.value = '';
                resNotesInput.value = '';
            });
        })();
    </script>
}
