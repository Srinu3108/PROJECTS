@model FarmManagement.Web.Models.Entities.PlantingSchedule

@{
    ViewData["Title"] = "Schedule Details";
    var schBadge = Model.Status switch {
        "Scheduled" => "badge-blue",
        "Completed" => "badge-green",
        "Cancelled" => "badge-gray",
        _           => "badge-yellow"
    };
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#dbeafe;color:#2563eb;">
                <i class="bi bi-calendar3"></i>
            </span>
            Schedule Details
        </h1>
        <p>Planting schedule #@Model.ScheduleId — @(Model.Crop?.CropName ?? "Unknown Crop")</p>
    </div>
    <a asp-action="Index" class="btn-fm btn-outline-fm">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="fm-card h-100">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-info-circle" style="color:#2563eb;"></i>
                    Schedule Information
                </span>
                <span class="badge-pill @schBadge">@Model.Status</span>
            </div>
            <div class="fm-card-body">
                <table style="width:100%;font-size:.875rem;">
                    <tr>
                        <td style="color:var(--fm-muted);padding:.4rem 0;width:45%;">Schedule ID</td>
                        <td>#@Model.ScheduleId</td>
                    </tr>
                    <tr>
                        <td style="color:var(--fm-muted);padding:.4rem 0;">Crop</td>
                        <td style="font-weight:600;">@(Model.Crop?.CropName ?? "—")</td>
                    </tr>
                    <tr>
                        <td style="color:var(--fm-muted);padding:.4rem 0;">Field</td>
                        <td>@(Model.Field?.FieldName ?? "—")</td>
                    </tr>
                    <tr>
                        <td style="color:var(--fm-muted);padding:.4rem 0;">Scheduled Date</td>
                        <td>@Model.ScheduledDate.ToString("dd MMM yyyy")</td>
                    </tr>
                    <tr>
                        <td style="color:var(--fm-muted);padding:.4rem 0;">Expected Yield</td>
                        <td style="font-weight:700;color:#2563eb;">@Model.ExpectedYieldKg kg</td>
                    </tr>
                    <tr>
                        <td style="color:var(--fm-muted);padding:.4rem 0;">Notes</td>
                        <td>@(Model.Notes ?? "—")</td>
                    </tr>
                </table>

                <div class="mt-3 d-flex gap-2">
                    @if (Model.Status == "Scheduled")
                    {
                        <a asp-action="RecordHarvest" asp-route-id="@Model.ScheduleId"
                           class="btn-fm btn-primary-fm btn-sm-fm">
                            <i class="bi bi-basket"></i> Record Harvest
                        </a>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("FieldSupervisor"))
                    {
                        <form asp-action="Delete" asp-route-id="@Model.ScheduleId"
                              method="post" class="d-inline"
                              onsubmit="return confirm('Delete this schedule?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-fm btn-danger-fm btn-sm-fm">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        @if (Model.Status != "Scheduled")
        {
        <div class="fm-card mb-4">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-basket" style="color:#16a34a;"></i>
                    Harvest Records
                </span>
            </div>
            @if (Model.Harvests == null || !Model.Harvests.Any())
            {
                <div class="empty-state" style="padding:2rem;">
                    <i class="bi bi-basket" style="font-size:2rem;opacity:.3;display:block;margin-bottom:.5rem;"></i>
                    <p>No harvest recorded yet.</p>
                </div>
            }
            else
            {
                <table class="fm-table">
                    <thead>
                        <tr>
                            <th>Harvested Date</th>
                            <th>Actual Yield</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Harvests)
                        {
                            <tr>
                                <td>@h.HarvestedDate.ToString("dd MMM yyyy")</td>
                                <td style="font-weight:700;color:#16a34a;">@h.ActualYieldKg kg</td>
                                <td>@(h.Notes ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        }

        <div class="fm-card">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-box-seam" style="color:#ea580c;"></i>
                    Resources Used
                </span>
            </div>
            @if (Model.ResourceUsages == null || !Model.ResourceUsages.Any())
            {
                <div class="empty-state" style="padding:2rem;">
                    <i class="bi bi-box-seam" style="font-size:2rem;opacity:.3;display:block;margin-bottom:.5rem;"></i>
                    <p>No resources allocated to this schedule.</p>
                </div>
            }
            else
            {
                <table class="fm-table">
                    <thead>
                        <tr>
                            <th>Resource</th>
                            <th>Quantity Used</th>
                            <th>Date</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.ResourceUsages)
                        {
                            <tr>
                                <td style="font-weight:600;">@(u.Resource?.Name ?? "—")</td>
                                <td>@u.QuantityUsed @(u.Resource?.Unit ?? "")</td>
                                <td>@u.UsedDate.ToString("dd MMM yyyy")</td>
                                <td>@(u.Notes ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Pest Incidents for this Crop -->
        <div class="fm-card mt-4">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-bug" style="color:#dc2626;"></i>
                    Pest Incidents
                </span>
            </div>
            @if (Model.Crop?.PestIncidents == null || !Model.Crop.PestIncidents.Any())
            {
                <div class="empty-state" style="padding:2rem;">
                    <i class="bi bi-shield-check" style="font-size:2rem;opacity:.3;display:block;margin-bottom:.5rem;"></i>
                    <p>No pest incidents reported for this crop.</p>
                </div>
            }
            else
            {
                <table class="fm-table">
                    <thead>
                        <tr>
                            <th>Pest Name</th>
                            <th>Disease Name</th>
                            <th>Status</th>
                            <th>Reported</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Crop.PestIncidents)
                        {
                            var pestBadge = p.Status switch {
                                FarmManagement.Web.Models.Enums.IncidentStatus.Active     => "badge-red",
                                FarmManagement.Web.Models.Enums.IncidentStatus.Monitoring => "badge-yellow",
                                _                                                          => "badge-green"
                            };
                            <tr>
                                <td style="font-weight:600;">@p.PestName</td>
                                <td>@(p.DiseaseName ?? "—")</td>
                                <td><span class="badge-pill @pestBadge">@p.Status</span></td>
                                <td>@p.ReportedDate.ToString("dd MMM yyyy")</td>
                                <td style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    @(p.Description ?? "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
