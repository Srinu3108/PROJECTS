@model FarmManagement.Web.Models.Entities.Resource
@{
    ViewData["Title"] = "Resource Details";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#ffedd5;color:#ea580c;">
                <i class="bi bi-box-seam"></i>
            </span>
            Resource Details
        </h1>
        <p>Viewing details for <strong>@Model.Name</strong>.</p>
    </div>
    <a asp-action="Index" class="btn-fm btn-outline-fm">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="fm-card" style="max-width:720px;">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-info-circle" style="color:#ea580c;"></i> @Model.Name</span>
    </div>
    <div class="fm-card-body">
        <table class="fm-table">
            <tr><th style="width:40%;">Resource ID</th><td>@Model.ResourceId</td></tr>
            <tr><th>Name</th><td style="font-weight:600;">@Model.Name</td></tr>
            <tr><th>Type</th><td><span class="badge-pill badge-gray">@Model.Type</span></td></tr>
            <tr>
                <th>Quantity</th>
                <td style="font-weight:700;color:@(Model.Quantity <= 10 ? "#dc2626" : "#16a34a");">
                    @Model.Quantity @Model.Unit
                </td>
            </tr>
            <tr><th>Last Updated</th><td>@Model.LastUpdated.ToString("dd MMM yyyy, hh:mm tt")</td></tr>
        </table>

        @if (Model.ResourceUsages.Any())
        {
            <p class="form-section-title mt-4">Allocation History</p>
            <table class="fm-table">
                <thead>
                    <tr>
                        <th>Schedule</th>
                        <th>Qty Used</th>
                        <th>Date</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usage in Model.ResourceUsages)
                    {
                        <tr>
                            <td>@(usage.PlantingSchedule?.Crop?.CropName ?? "Schedule") #@usage.ScheduleId</td>
                            <td style="font-weight:600;">@usage.QuantityUsed @Model.Unit</td>
                            <td>@usage.UsedDate.ToString("dd MMM yyyy")</td>
                            <td>@(usage.Notes ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="mt-4 d-flex gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("Farmer"))
            {
                <a asp-action="Edit" asp-route-id="@Model.ResourceId" class="btn-fm btn-warn-fm">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            }
            <a asp-action="Allocate" asp-route-id="@Model.ResourceId" class="btn-fm btn-primary-fm">
                <i class="bi bi-arrow-right-circle"></i> Allocate
            </a>
        </div>
    </div>
</div>
