@model IEnumerable<FarmManagement.Web.Models.Entities.Resource>

@{
    ViewData["Title"] = "Resource Inventory";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#ffedd5;color:#ea580c;">
                <i class="bi bi-box-seam"></i>
            </span>
            Resource Inventory
        </h1>
        <p>Monitor farm supplies, equipment, and stock levels.</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Farmer") || User.IsInRole("Storekeeper"))
    {
        <a asp-action="Create" class="btn-fm btn-primary-fm">
            <i class="bi bi-plus-circle"></i> Add Resource
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="fm-alert fm-alert-success mb-3">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="fm-alert fm-alert-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

@if (Model.Any(r => r.Quantity <= 10))
{
    <div class="fm-alert fm-alert-warning mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
            <strong>Low Stock Warning!</strong>
            @Model.Count(r => r.Quantity <= 10) resource(s) are running low (quantity &le; 10).
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#f1f5f9;color:#475569;">
                <i class="bi bi-box-seam"></i>
            </div>
            <div>
                <div class="stat-value">@Model.Count()</div>
                <div class="stat-label">Total Resources</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fee2e2;color:#dc2626;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#dc2626;">@Model.Count(r => r.Quantity <= 10)</div>
                <div class="stat-label">Low Stock Items</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#16a34a;">@Model.Count(r => r.Quantity > 50)</div>
                <div class="stat-label">Well Stocked Items</div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="mb-3 d-flex gap-2" style="max-width:400px;">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search resources..." />
    <button type="submit" class="btn-fm btn-primary-fm"><i class="bi bi-search"></i></button>
    @if (!string.IsNullOrEmpty((string?)ViewBag.Search))
    {
        <a asp-action="Index" class="btn-fm btn-outline-fm"><i class="bi bi-x-lg"></i></a>
    }
</form>

<div class="fm-card">
    <div class="fm-card-header">
        <span class="ch-title">
            <i class="bi bi-table" style="color:#ea580c;"></i>
            All Resources
        </span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.Count() records</span>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-box-seam"></i>
            <p>No resources found. Add your first resource to get started.</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Resource Name</th>
                        <th>Type</th>
                        <th>Quantity</th>
                        <th>Unit</th>
                        <th>Stock Status</th>
                        <th>Last Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var sno = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@(sno++)</td>
                            <td style="font-weight:600;">@item.Name</td>
                            <td><span class="badge-pill badge-gray">@item.Type</span></td>
                            <td style="font-weight:700;color:@(item.Quantity <= 10 ? "#dc2626" : "#16a34a");">
                                @item.Quantity
                            </td>
                            <td>@item.Unit</td>
                            <td>
                                @if (item.Quantity <= 10)
                                {
                                    <span class="badge-pill badge-red">
                                        <i class="bi bi-exclamation-triangle"></i> Low
                                    </span>
                                }
                                else if (item.Quantity <= 50)
                                {
                                    <span class="badge-pill badge-yellow">
                                        <i class="bi bi-dash-circle"></i> Medium
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-pill badge-green">
                                        <i class="bi bi-check-circle"></i> In Stock
                                    </span>
                                }
                            </td>
                            <td>@item.LastUpdated.ToString("dd MMM yyyy")</td>
                            <td>
                                <div style="display:flex;gap:.3rem;flex-wrap:wrap;">
                                    <a asp-action="Details" asp-route-id="@item.ResourceId"
                                       class="btn-fm btn-info-fm btn-sm-fm">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Farmer") || User.IsInRole("Storekeeper"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.ResourceId"
                                           class="btn-fm btn-warn-fm btn-sm-fm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (User.IsInRole("Admin") || User.IsInRole("Farmer") || User.IsInRole("Storekeeper"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.ResourceId"
                                              method="post" class="d-inline delete-form">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn-fm btn-danger-fm btn-sm-fm btn-delete"
                                                    data-name="@item.Name">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
                 </div>
            }
        </div>

        @section Scripts {
            <script>
                document.querySelectorAll('.btn-delete').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var name = this.getAttribute('data-name');
                        if (confirm('Are you sure you want to delete "' + name + '"?')) {
                            this.closest('form').submit();
                        }
                    });
                });
            </script>
        }
