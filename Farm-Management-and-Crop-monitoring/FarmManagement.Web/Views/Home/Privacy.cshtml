@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-shield-lock"></i> Privacy Policy</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title">Data We Collect</h5>
        <p class="text-muted">
            FarmManagement collects and stores farm-related data including crop records,
            field information, planting schedules, harvest data, pest incidents, and
            resource inventory. All data is stored securely in a local database.
        </p>

        <hr />

        <h5 class="card-title">How We Use Your Data</h5>
        <p class="text-muted">
            Data collected is used solely for farm management purposes — tracking crops,
            monitoring pest incidents, managing resources, and generating yield analytics.
            Your data is never shared with third parties.
        </p>

        <hr />

        <h5 class="card-title">Data Security</h5>
        <p class="text-muted">
            All data is stored in a secured SQL Server database. Access is restricted
            to authorised users of this application only.
        </p>

        <hr />

        <h5 class="card-title">Contact</h5>
        <p class="text-muted">
            For any privacy-related concerns regarding this application, please contact
            your system administrator.
        </p>
    </div>
</div>