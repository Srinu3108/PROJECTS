@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-card-body">

        <!-- Header -->
        <div style="display:flex;align-items:center;gap:.65rem;margin-bottom:1.5rem;">
            <div style="width:40px;height:40px;background:linear-gradient(135deg,#dcfce7,#bbf7d0);border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:#15803d;flex-shrink:0;">
                <i class="bi bi-box-arrow-in-right"></i>
            </div>
            <div>
                <div class="auth-card-title">Welcome back</div>
                <div class="auth-card-sub" style="margin-bottom:0;">Sign in to your AgroManage account</div>
            </div>
        </div>

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            @{
                var modelErrors = ViewData.ModelState[string.Empty]?.Errors;
            }
            @if (modelErrors != null && modelErrors.Count > 0)
            {
                foreach (var error in modelErrors)
                {
                    var isSuspended = error.ErrorMessage.Contains("suspended", StringComparison.OrdinalIgnoreCase);
                    var bgColor = isSuspended ? "#fff7ed" : "#fef2f2";
                    var borderColor = isSuspended ? "#fed7aa" : "#fecaca";
                    var textColor = isSuspended ? "#9a3412" : "#991b1b";
                    var icon = isSuspended ? "bi-person-lock" : "bi-exclamation-circle-fill";
                    <div class="alert py-2 px-3 rounded-3 mb-3 d-flex align-items-center gap-2" style="font-size:.82rem;border:1px solid @borderColor;background:@bgColor;color:@textColor;">
                        <i class="bi @icon"></i>
                        <span>@error.ErrorMessage</span>
                    </div>
                }
            }

            <!-- Email -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-envelope input-icon-left"></i>
                    <input asp-for="Email" class="form-control"
                           placeholder="you@example.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger" style="font-size:.75rem;"></span>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-icon-wrap" style="position:relative;">
                    <i class="bi bi-lock input-icon-left"></i>
                    <input asp-for="Password" id="loginPassword" class="form-control"
                           style="padding-right:2.6rem;"
                           placeholder="Enter your password" autocomplete="current-password" />
                    <i class="bi bi-eye-slash pw-toggle" id="loginToggleIcon"
                       onclick="togglePassword('loginPassword','loginToggleIcon')"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger" style="font-size:.75rem;"></span>
            </div>

            <!-- Remember + Forgot -->
            <div class="mb-4 d-flex align-items-center justify-content-between">
                <label style="display:flex;align-items:center;gap:.4rem;font-size:.8rem;color:#64748b;cursor:pointer;">
                    <input asp-for="RememberMe" style="width:15px;height:15px;accent-color:#16a34a;" />
                    Remember me
                </label>
                <a asp-action="ForgotPassword" style="font-size:.8rem;color:#16a34a;font-weight:600;text-decoration:none;">
                    Forgot password?
                </a>
            </div>

            <button type="submit" class="btn-auth">
                <i class="bi bi-box-arrow-in-right"></i>
                Sign In
            </button>
        </form>
    </div>

    <div class="auth-card-footer">
        <span class="auth-footer-text">Don't have an account?</span>
        <a asp-action="Register" class="auth-footer-link ms-1">Create one &rarr;</a>
    </div>
</div>

<!-- Credentials hint box -->
<div style="margin-top:1rem;background:rgba(22,163,74,.06);border:1px solid rgba(22,163,74,.18);border-radius:12px;padding:.85rem 1.1rem;font-size:.77rem;color:#166534;">
    <div style="font-weight:700;margin-bottom:.35rem;display:flex;align-items:center;gap:.35rem;">
        <i class="bi bi-info-circle-fill" style="color:#16a34a;"></i>
        Demo credentials
    </div>
    <div style="display:flex;flex-direction:column;gap:.18rem;color:#15803d;">
        <span><strong>Email:</strong> admin@farmmanagement.com</span>
        <span><strong>Password:</strong> Admin@123</span>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
