@model FarmManagement.Web.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-card-body">
        <h4 class="fw-bold mb-1" style="color:#1a3c2b;">Forgot Password</h4>
        <p class="text-muted small mb-4">Enter your email address to reset your password</p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 mb-3"></div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label">Email address</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3">
                        <i class="bi bi-envelope text-muted"></i>
                    </span>
                    <input asp-for="Email" class="form-control border-start-0 ps-0"
                           style="border-radius:0 10px 10px 0;"
                           placeholder="you@example.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-auth">
                <i class="bi bi-arrow-right me-2"></i>Continue
            </button>
        </form>
    </div>

    <div class="auth-card-footer">
        <span class="auth-footer-text">Remember your password?</span>
        <a asp-action="Login" class="auth-footer-link ms-1">Sign in here</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
