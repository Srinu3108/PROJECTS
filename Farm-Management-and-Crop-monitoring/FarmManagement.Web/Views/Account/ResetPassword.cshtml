@model FarmManagement.Web.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-card-body">
        <h4 class="fw-bold mb-1" style="color:#1a3c2b;">Reset Password</h4>
        <p class="text-muted small mb-4">Enter your password hint and set a new password</p>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 mb-3"></div>

            <input type="hidden" asp-for="Email" />

            <div class="mb-3">
                <label asp-for="Hint" class="form-label">Password Hint</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3">
                        <i class="bi bi-lightbulb text-muted"></i>
                    </span>
                    <input asp-for="Hint" class="form-control border-start-0 ps-0"
                           style="border-radius:0 10px 10px 0;"
                           placeholder="Enter the hint you set during registration" />
                </div>
                <span asp-validation-for="Hint" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input asp-for="NewPassword" class="form-control border-start-0 ps-0"
                           style="border-radius:0 10px 10px 0;"
                           placeholder="Minimum 6 characters" autocomplete="new-password" />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3">
                        <i class="bi bi-lock-fill text-muted"></i>
                    </span>
                    <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0"
                           style="border-radius:0 10px 10px 0;"
                           placeholder="Re-enter your new password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-auth">
                <i class="bi bi-check-circle me-2"></i>Reset Password
            </button>
        </form>
    </div>

    <div class="auth-card-footer">
        <span class="auth-footer-text">Remember your password?</span>
        <a asp-action="Login" class="auth-footer-link ms-1">Sign in here</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
