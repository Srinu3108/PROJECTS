@model IEnumerable<FarmManagement.Web.Models.Entities.Crop>

@{
    ViewData["Title"] = "Crops";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#dbeafe;color:#2563eb;">
                <i class="bi bi-flower1"></i>
            </span>
            Crop Inventory
        </h1>
        <p>Manage and monitor all crops across your fields.</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Farmer") || User.IsInRole("FieldSupervisor"))
    {
        <a asp-action="Create" class="btn-fm btn-primary-fm">
            <i class="bi bi-plus-circle"></i> Add Crop
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="fm-alert fm-alert-success mb-3">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="fm-alert fm-alert-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<form method="get" class="mb-3 d-flex gap-2" style="max-width:400px;">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search crops..." />
    <button type="submit" class="btn-fm btn-primary-fm"><i class="bi bi-search"></i></button>
    @if (!string.IsNullOrEmpty((string?)ViewBag.Search))
    {
        <a asp-action="Index" class="btn-fm btn-outline-fm"><i class="bi bi-x-lg"></i></a>
    }
</form>

<div class="fm-card">
    <div class="fm-card-header">
        <span class="ch-title">
            <i class="bi bi-table" style="color:var(--fm-green);"></i>
            All Crops
        </span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.Count() records</span>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-flower1"></i>
            <p>No crops found. Add your first crop to get started.</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Crop Name</th>
                        <th>Type</th>
                        <th>Season</th>
                        <th>Field</th>
                        <th>Planting Date</th>
                        <th>Expected Harvest</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var sno = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@(sno++)</td>
                            <td style="font-weight:600;">@item.CropName</td>
                            <td>@item.CropType</td>
                            <td>@item.Season</td>
                            <td>
                                <span class="badge-pill badge-gray">@(item.Field?.FieldName ?? "—")</span>
                            </td>
                            <td>@item.PlantingDate.ToString("dd MMM yyyy")</td>
                            <td>@item.ExpectedHarvestDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @{
                                    var cropBadge = item.Status switch {
                                        "Growing"   => "badge-green",
                                        "Harvested" => "badge-gray",
                                        _           => "badge-yellow"
                                    };
                                }
                                <span class="badge-pill @cropBadge">@item.Status</span>
                            </td>
                            <td>
                                <div style="display:flex;gap:.3rem;flex-wrap:wrap;">
                                    <a asp-action="Details" asp-route-id="@item.CropId"
                                       class="btn-fm btn-info-fm btn-sm-fm">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Farmer") || User.IsInRole("FieldSupervisor"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.CropId"
                                           class="btn-fm btn-warn-fm btn-sm-fm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.CropId"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Delete @item.CropName?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-fm btn-danger-fm btn-sm-fm">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
