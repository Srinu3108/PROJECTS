@model FarmManagement.Web.Models.ViewModels.FieldViewModel

@{
    ViewData["Title"] = "Edit Field";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#fef9c3;color:#ca8a04;">
                <i class="bi bi-pencil"></i>
            </span>
            Edit Field
        </h1>
        <p>Update the details for this field.</p>
    </div>
    <a asp-action="Index" class="btn-fm btn-outline-fm">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="fm-card" style="max-width:720px;">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-grid-3x3-gap" style="color:#16a34a;"></i> Field Details</span>
    </div>
    <div class="fm-card-body fm-form">
        <form asp-action="Edit" asp-route-id="@Model.FieldId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="FieldId" />
            <div asp-validation-summary="ModelOnly" class="fm-alert fm-alert-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FieldName" class="form-label"></label>
                    <div class="fm-field">
                        <i class="bi bi-map-fill fm-fi" style="color:#16a34a;"></i>
                        <input asp-for="FieldName" class="form-control" />
                    </div>
                    <span asp-validation-for="FieldName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AreaHectares" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="AreaHectares" class="form-control" />
                        <span class="input-group-text">ha</span>
                    </div>
                    <span asp-validation-for="AreaHectares" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SoilType" class="form-label"></label>
                    <div class="fm-field">
                        <i class="bi bi-layers fm-fi" style="color:#78350f;"></i>
                        <select asp-for="SoilType" class="form-select">
                            <option value="">-- Select Soil Type --</option>
                            <option value="Loamy">Loamy</option>
                            <option value="Clay">Clay</option>
                            <option value="Sandy">Sandy</option>
                            <option value="Sandy Loam">Sandy Loam</option>
                            <option value="Silt">Silt</option>
                            <option value="Peaty">Peaty</option>
                            <option value="Chalky">Chalky</option>
                        </select>
                    </div>
                    <span asp-validation-for="SoilType" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Location" class="form-label"></label>
                    <div class="fm-field">
                        <i class="bi bi-geo-alt fm-fi" style="color:#dc2626;"></i>
                        <input asp-for="Location" class="form-control" />
                    </div>
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
            </div>

            <div class="fm-actions">
                <button type="submit" class="btn-fm btn-warn-fm">
                    <i class="bi bi-pencil"></i> Update Field
                </button>
                <a asp-action="Index" class="btn-fm btn-ghost-fm">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
