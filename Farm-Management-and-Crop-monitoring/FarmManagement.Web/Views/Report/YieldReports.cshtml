@model IEnumerable<FarmManagement.Web.Models.Entities.YieldReport>
@{
    ViewData["Title"] = "Yield Reports";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#ede9fe;color:#7c3aed;"><i class="bi bi-clipboard-data"></i></span>
            Yield Reports
        </h1>
        <p>Generated yield reports with average yield per acre.</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="GenerateYieldReport" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-fm btn-primary-fm">
                <i class="bi bi-lightning"></i> Generate Report
            </button>
        </form>
        <a asp-action="Index" class="btn-fm btn-outline-fm"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="fm-alert fm-alert-success mb-3"><i class="bi bi-check-circle-fill"></i><span>@TempData["Success"]</span></div>
}

<div class="fm-card">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-table" style="color:#7c3aed;"></i> Saved Reports</span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.Count() records</span>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-clipboard-data"></i><p>No yield reports generated yet. Click "Generate Report" to create one.</p></div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr><th>#</th><th>Crop</th><th>Season</th><th>Year</th><th>Total Yield (kg)</th><th>Avg Yield / Acre</th><th>Generated</th><th>Remarks</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@r.YieldReportId</td>
                            <td style="font-weight:600;">@(r.Crop?.CropName ?? "—")</td>
                            <td><span class="badge-pill badge-gray">@r.Season</span></td>
                            <td>@r.Year</td>
                            <td style="font-weight:700;color:#16a34a;">@r.TotalYieldKg.ToString("N0")</td>
                            <td style="font-weight:700;color:#2563eb;">@r.AverageYieldPerAcre.ToString("N2")</td>
                            <td>@r.GeneratedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>@(r.Remarks ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
