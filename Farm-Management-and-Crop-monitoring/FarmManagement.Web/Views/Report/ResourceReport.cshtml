@model FarmManagement.Web.Models.ViewModels.ResourceReportViewModel
@{
    ViewData["Title"] = "Resource Usage Report";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#ffedd5;color:#ea580c;"><i class="bi bi-box-seam"></i></span>
            Resource Usage Report
        </h1>
        <p>Stock levels and allocation summary for all resources.</p>
    </div>
    <a asp-action="Index" class="btn-fm btn-outline-fm"><i class="bi bi-arrow-left"></i> Back to Reports</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#f1f5f9;color:#475569;"><i class="bi bi-box-seam"></i></div>
            <div><div class="stat-value">@Model.TotalResources</div><div class="stat-label">Total Resources</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-exclamation-triangle"></i></div>
            <div><div class="stat-value" style="color:#dc2626;">@Model.LowStockCount</div><div class="stat-label">Low Stock</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dbeafe;color:#2563eb;"><i class="bi bi-arrow-right-circle"></i></div>
            <div><div class="stat-value" style="color:#2563eb;">@Model.TotalAllocations</div><div class="stat-label">Total Allocations</div></div>
        </div>
    </div>
</div>

<div class="fm-card">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-table" style="color:#ea580c;"></i> Resource Inventory</span>
    </div>
    <div style="overflow-x:auto;">
        <table class="fm-table">
            <thead>
                <tr><th>Name</th><th>Type</th><th>Quantity</th><th>Unit</th><th>Allocations</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Resources)
                {
                    <tr>
                        <td style="font-weight:600;">@r.Name</td>
                        <td><span class="badge-pill badge-gray">@r.Type</span></td>
                        <td style="font-weight:700;color:@(r.Quantity <= 10 ? "#dc2626" : "#16a34a");">@r.Quantity</td>
                        <td>@r.Unit</td>
                        <td>@r.ResourceUsages.Count</td>
                        <td>
                            @if (r.Quantity <= 10)
                            { <span class="badge-pill badge-red">Low</span> }
                            else if (r.Quantity <= 50)
                            { <span class="badge-pill badge-yellow">Medium</span> }
                            else
                            { <span class="badge-pill badge-green">In Stock</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Type-wise Breakdown -->
<div class="fm-card mt-4">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-bar-chart" style="color:#ea580c;"></i> Type-wise Breakdown</span>
    </div>
    @if (Model.TypeBreakdown.Any())
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr><th>Type</th><th>Count</th><th>Total Quantity</th></tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.TypeBreakdown)
                    {
                        <tr>
                            <td style="font-weight:600;">@t.Type</td>
                            <td>@t.Count</td>
                            <td style="font-weight:700;">@t.TotalQty</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state"><p>No type breakdown data available.</p></div>
    }
</div>
