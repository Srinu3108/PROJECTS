                                            background: #161b22;
                                            padding: 16px;
                                            border-radius: 10px;
                                            border: 1px solid #30363d;
                                            text-align: center;
                                            ">
                                            <p style="color: #8b949e; margin: 0 0 8px 0; font-size: 11px; text-transform: uppercase;">Active
                                                Devices</p>
                                                <p style="color: #2ecc71; margin: 0; font-size: 26px; font-weight: bold;">
                                                    @dashboard.ActiveDevices/@dashboard.TotalDevices</p>
                                                </div>

                                                <div style="
                                                    background: #161b22;
                                                    padding: 16px;
                                                    border-radius: 10px;
                                                    border: 1px solid #30363d;
                                                    text-align: center;
                                                    ">
                                                    <p style="color: #8b949e; margin: 0 0 8px 0; font-size: 11px; text-transform: uppercase;">High
                                                        Alerts</p>
                                                        <p
                                                            style="color: @(dashboard.HighAlerts > 0 ? "#e74c3c" : "#2ecc71"); margin: 0; font-size: 26px; font-weight: bold;">
                                                            @dashboard.HighAlerts</p>
                                                        </div>

                                                        <div style="
                                                            background: #161b22;
                                                            padding: 16px;
                                                            border-radius: 10px;
                                                            border: 1px solid #30363d;
                                                            text-align: center;
                                                            ">
                                                            <p style="color: #8b949e; margin: 0 0 8px 0; font-size: 11px; text-transform: uppercase;">System
                                                                Health</p>
                                                                <p
                                                                    style="color: @(dashboard.HighAlerts > 0 ? "#e74c3c" : "#2ecc71"); margin: 0; font-size: 26px; font-weight: bold;">
                                                                    @(dashboard.HighAlerts > 0 ? "⚠️" : "✅")</p>
                                                                </div>
                                                            </div>

                                                            <!-- MAIN CARDS -->
                                                            <div style="
                                                                display: grid;
                                                                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                                                                gap: 16px;
                                                                margin-bottom: 20px;
                                                                ">
                                                                <!-- Performance -->
                                                                <div style="
                                                                    background: #161b22;
                                                                    border: 1px solid #30363d;
                                                                    padding: 20px;
                                                                    border-radius: 12px;
                                                                    box-shadow: 0 8px 16px rgba(0,0,0,0.2);
                                                                    ">
                                                                    <h3 style="color: #58a6ff; margin: 0 0 12px 0; font-size: 15px;">⚡ Performance Index</h3>
                                                                    <div style="text-align: center;">
                                                                        <div style="
                                                                        font-size: 42px;
                                                                        font-weight: bold;
                                                                        color: @(dashboard.SystemPerformanceIndex >= 80 ? "#2ecc71" : dashboard.SystemPerformanceIndex >= 60 ? "#f1c40f" : "#e74c3c");
                                                                        margin: 10px 0;
                                                                        ">@dashboard.SystemPerformanceIndex%</div>
                                                                        <p
                                                                            style="color: @(dashboard.SystemPerformanceIndex >= 80 ? "#2ecc71" : dashboard.SystemPerformanceIndex >= 60 ? "#f1c40f" : "#e74c3c"); margin: 0; font-size: 12px; font-weight: 600;">
                                                                            @(dashboard.SystemPerformanceIndex >= 80 ? "✅ OPTIMAL" : dashboard.SystemPerformanceIndex >=
                                                                        60 ? "⚠️ FAIR" : "❌ CRITICAL")
                                                                        </p>
                                                                    </div>
                                                                </div>

                                                                <!-- Devices -->
                                                                <div style="
                                                                    background: #161b22;
                                                                    border: 1px solid #30363d;
                                                                    padding: 20px;
                                                                    border-radius: 12px;
                                                                    box-shadow: 0 8px 16px rgba(0,0,0,0.2);
                                                                    ">
                                                                    <h3 style="color: #58a6ff; margin: 0 0 12px 0; font-size: 15px;">📊 Devices</h3>
                                                                    <div style="display: grid; gap: 8px;">
                                                                        <div
                                                                            style="display: flex; justify-content: space-between; padding: 8px; background: #0d1117; border-radius: 6px;">
                                                                            <span style="color: #8b949e; font-size: 12px;">Total</span>
                                                                            <span style="color: #58a6ff; font-weight: bold;">@dashboard.TotalDevices</span>
                                                                        </div>
                                                                        <div
                                                                            style="display: flex; justify-content: space-between; padding: 8px; background: #0d1117; border-radius: 6px;">
                                                                            <span style="color: #8b949e; font-size: 12px;">Active 🟢</span>
                                                                            <span style="color: #2ecc71; font-weight: bold;">@dashboard.ActiveDevices</span>
                                                                        </div>
                                                                        <div
                                                                            style="display: flex; justify-content: space-between; padding: 8px; background: #0d1117; border-radius: 6px;">
                                                                            <span style="color: #8b949e; font-size: 12px;">Offline 🔴</span>
                                                                            <span style="color: #e74c3c; font-weight: bold;">@(dashboard.TotalDevices -
                                                                                                                                                                                                                                                                                                                                                                                                                                        dashboard.ActiveDevices)</span>
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Alerts -->
                                                                    <div style="
                                                                        background: #161b22;
                                                                        border: 1px solid #30363d;
                                                                        padding: 20px;
                                                                        border-radius: 12px;
                                                                        box-shadow: 0 8px 16px rgba(0,0,0,0.2);
                                                                        ">
                                                                        <h3 style="color: #ff4d4d; margin: 0 0 12px 0; font-size: 15px;">🔴 Alerts</h3>
                                                                        <div style="display: grid; gap: 8px;">
                                                                            <div
                                                                                style="display: flex; justify-content: space-between; padding: 8px; background: #0d1117; border-radius: 6px;">
                                                                                <span style="color: #8b949e; font-size: 12px;">High 🔴</span>
                                                                                <span style="color: #e74c3c; font-weight: bold;">@dashboard.HighAlerts</span>
                                                                            </div>
                                                                            <div
                                                                                style="display: flex; justify-content: space-between; padding: 8px; background: #0d1117; border-radius: 6px;">
                                                                                <span style="color: #8b949e; font-size: 12px;">Medium 🟡</span>
                                                                                <span style="color: #f1c40f; font-weight: bold;">@dashboard.MediumAlerts</span>
                                                                            </div>
                                                                            <div
                                                                                style="display: flex; justify-content: space-between; padding: 8px; background: #0d1117; border-radius: 6px;">
                                                                                <span style="color: #8b949e; font-size: 12px;">Total</span>
                                                                                <span style="color: #e6edf3; font-weight: bold;">@(dashboard.HighAlerts +
                                                                                                                                                                                                                                                                                                                                                                                                                                                            dashboard.MediumAlerts)</span>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <!-- QUICK ACTIONS -->
                                                                    <div style="
                                                                        display: grid;
                                                                        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
                                                                        gap: 10px;
                                                                        ">
                                                                        <button @onclick="() => GoToReport()" style="
                                                                        background: linear-gradient(135deg, #1f6feb 0%, #0969da 100%);
                                                                        color: white;
                                                                        padding: 10px;
                                                                        border: none;
                                                                        border-radius: 8px;
                                                                        font-size: 12px;
                                                                        font-weight: 500;
                                                                        cursor: pointer;
                                                                        ">📄 Report</button>
                                                                        <button @onclick="() => GoToAnalytics()" style="
                                                                        background: linear-gradient(135deg, #238636 0%, #1a6e2b 100%);
                                                                        color: white;
                                                                        padding: 10px;
                                                                        border: none;
                                                                        border-radius: 8px;
                                                                        font-size: 12px;
                                                                        font-weight: 500;
                                                                        cursor: pointer;
                                                                        ">📊 Analytics</button>
                                                                        <button @onclick="() => GoToDevices()" style="
                                                                        background: linear-gradient(135deg, #6e40aa 0%, #533097 100%);
                                                                        color: white;
                                                                        padding: 10px;
                                                                        border: none;
                                                                        border-radius: 8px;
                                                                        font-size: 12px;
                                                                        font-weight: 500;
                                                                        cursor: pointer;
                                                                        ">🔍 Details</button>
                                                                        <button @onclick="() => GoToAlerts()" style="
                                                                        background: linear-gradient(135deg, #d1250c 0%, #a01c0f 100%);
                                                                        color: white;
                                                                        padding: 10px;
                                                                        border: none;
                                                                        border-radius: 8px;
                                                                        font-size: 12px;
                                                                        font-weight: 500;
                                                                        cursor: pointer;
                                                                        ">🚨 Alerts</button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>

@code {
    DashboardDto? dashboard;
    string errorMessage = "";
    string currentTime = DateTime.Now.ToString("hh:mm tt");
    bool isAuthenticated = false;
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Check authentication status
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (isAuthenticated)
        {
            await LoadDashboard();
        }
        else
        {
            dashboard = null;
            errorMessage = "";
        }
    }

    async Task LoadDashboard()
    {
        try
        {
            errorMessage = "";
            dashboard = await Http.GetFromJsonAsync<DashboardDto>("api/report/summary/1");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load: {ex.Message}";
            dashboard = null;
        }
    }

    async Task ReloadDashboard()
    {
        if (!isAuthenticated)
        {
            return;
        }
        await LoadDashboard();
        StateHasChanged();
    }

    async Task GenerateReport()
    {
        if (!isAuthenticated)
        {
            return;
        }

        try
        {
            var report = await Http.GetFromJsonAsync<ReportDto>("api/report/summary/1");
            if (report == null)
                return;

            var issueLines = report.UnderperformingDevices.Any()
                ? string.Join("\n", report.UnderperformingDevices.Select(d => $"- {d.DeviceName}: {d.Issue} ({d.PerformanceIndex}%)"))
                : "None identified.";

            var content = $@"
EnergyPulse Maintenance Report - {DateTime.Now:yyyy-MM-dd HH:mm}
==============================================

SYSTEM PERFORMANCE INDEX: {report.SystemPerformanceIndex:F0}%
ACTIVE DEVICES: {report.ActiveDevices}/{report.TotalDevices}
HIGH ALERTS: {report.HighAlerts}
MAINTENANCE ISSUES: {report.MaintenanceIssues}

UNDERPERFORMING DEVICES:
{issueLines}

This one-click report is ready for your maintenance team.
";
            var bytes = System.Text.Encoding.UTF8.GetBytes(content);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile", "energypulse-maintenance-report.txt", base64);
        }
        catch { }
    }

    protected override void OnInitialized()
    {
        var timer = new System.Timers.Timer(10000);
        timer.Elapsed += (s, e) =>
        {
            currentTime = DateTime.Now.ToString("hh:mm tt");
            InvokeAsync(StateHasChanged);
        };
        timer.Start();
    }

    void GoToReport() => Navigation.NavigateTo("/report");
    void GoToAnalytics() => Navigation.NavigateTo("/charts");
    void GoToDevices() => Navigation.NavigateTo("/devices");
    void GoToAlerts() => Navigation.NavigateTo("/alerts");

    public class DashboardDto
    {
        public int TotalDevices { get; set; }
        public int ActiveDevices { get; set; }
        public double AverageEfficiency { get; set; }
        public double SystemPerformanceIndex { get; set; }
        public int HighAlerts { get; set; }
        public int MediumAlerts { get; set; }
    }

    public class ReportDto
    {
        public string Site { get; set; }
        public int TotalDevices { get; set; }
        public int ActiveDevices { get; set; }
        public double AverageEfficiency { get; set; }
        public double SystemPerformanceIndex { get; set; }
        public int HighAlerts { get; set; }
        public DateTime GeneratedAt { get; set; }
        public List<ReportDeviceIssueDto> UnderperformingDevices { get; set; } = new();
        public int MaintenanceIssues => UnderperformingDevices.Count;
    }

    public class ReportDeviceIssueDto
    {
        public string DeviceName { get; set; }
        public string Status { get; set; }
        public double PerformanceIndex { get; set; }
        public string Issue { get; set; }
    }
}